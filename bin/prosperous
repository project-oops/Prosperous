#!/usr/bin/env bash
# prosperous - the one dev command for this repository.
#
#   ./bin/prosperous build        # release build of the workspace
#   ./bin/prosperous test         # the test suite
#   ./bin/prosperous lint         # clippy at -D warnings
#   ./bin/prosperous fmt          # format in place
#   ./bin/prosperous check        # the full gate. What CI runs.
#   ./bin/prosperous clean        # remove build output
#   ./bin/prosperous doc          # build the API docs
#   ./bin/prosperous provenance   # no payload binaries are tracked
#   ./bin/prosperous target       # the read-only tests against a real target
#
# The workspace takes oops-libs and selfish by relative path, as siblings;
# `oops bootstrap prosperous` fetches them.
set -euo pipefail

# Absolute before the cd, because usage() reads this file back.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die() { printf '\n\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }
step() { printf '\n\033[1;36m-- %s\033[0m\n' "$*"; }

# Payload binaries are never tracked: they are GPL-3.0, and shipping one obliges offering its
# source. Detection is by content as well as extension, since an ELF need not have one.
provenance() {
    step "no payload binaries are tracked"

    # Outside a git repository nothing can be checked, which is a failure, not a pass.
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
        die "not a git repository, so nothing could be checked - this is not a pass"

    local found
    # Images are the only binaries this repository tracks.
    tracked_binaries() {
        git ls-files | while IFS= read -r f; do
            case "$f" in *.png|*.ico|*.svg|*.jpg|*.gif|*.woff2) continue ;; esac
            [ -f "$f" ] || continue
            case "$(head -c 4 "$f" | od -An -tx1 | tr -d ' ')" in
                7f454c46*|4d5a*|cffaedfe*|cefaedfe*) printf '%s\n' "$f" ;;
            esac
        done
    }

    found=$(git ls-files -- '*.elf' '*.bin' '*.prx' '*.sprx' '*.pkg')
    if [ -n "$found" ]; then
        echo "$found"
        die "these are payload binaries and must not be tracked - ship the manifest instead"
    fi

    found="$(tracked_binaries)"
    if [ -n "$found" ]; then
        echo "$found"
        die "these are executables, whatever they are named - they must not be tracked"
    fi
}

check() {
    provenance
    step "cargo fmt --all -- --check"
    cargo fmt --all -- --check
    step "cargo clippy --all-targets -- -D warnings"
    cargo clippy --all-targets -- -D warnings
    step "cargo test"
    cargo test
    step "cargo doc (warnings are errors)"
    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --workspace --quiet
    printf '\n\033[1;32mall checks passed\033[0m\n'
}

# The tests that need a real target. They are `#[ignore]` by default, so `check` runs anywhere
# and reports them as ignored.
target() {
    [ -n "${PROS_TARGET:-}" ] ||
        die "set PROS_TARGET to the target's address first"
    step "against $PROS_TARGET (read-only)"
    cargo test -p pros-core --test against_a_target -- --ignored --nocapture --test-threads=1
    printf '\n\033[1;32mthe target agrees\033[0m\n'
}

# Extra arguments pass through to cargo, so the release workflow's `--target <triple>` uses
# this verb too.
build() { step "cargo build --release --workspace $*"; cargo build --release --workspace "$@"; }
test_() { step "cargo test --workspace"; cargo test --workspace; }
lint()  { step "cargo clippy --all-targets -- -D warnings"; cargo clippy --all-targets -- -D warnings; }
fmt()   { step "cargo fmt --all"; cargo fmt --all; }
clean() { step "cargo clean"; cargo clean; }
doc()   { step "cargo doc --no-deps --workspace"; cargo doc --no-deps --workspace; }

# Prints the header, found rather than hardcoded.
usage() {
    local last
    last=$(( $(grep -n '^set -euo' "$SELF" | head -1 | cut -d: -f1) - 1 ))
    sed -n "2,${last}p" "$SELF" | sed 's/^# \{0,1\}//'
}

case "${1:-check}" in
    check) check ;;
    build) shift; build "$@" ;;
    test)  test_ ;;
    lint)  lint ;;
    fmt)   fmt ;;
    clean) clean ;;
    doc)   doc ;;
    provenance) provenance ;;
    target) target ;;
    -h|--help|help) usage ;;
    *) die "unknown verb: $1 (try ./bin/prosperous --help)" ;;
esac
